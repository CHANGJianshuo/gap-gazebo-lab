# Keep original CAD, upstream resources, and recorded evidence byte-for-byte.
* -text
*.stp binary
*.step binary
*.stl binary
*.STL binary
*.dae binary
*.DAE binary
*.png binary
*.pdf binary
*.mp4 binary
*.otf binary

# Generated curves and snapshots can contain formatting from their generators.
*.svg -whitespace linguist-generated=true
# Patch context whitespace is part of the patch payload.
*.patch -whitespace
data/runs/** -whitespace linguist-generated=true
docs/competition/extracted/** -whitespace linguist-generated=true
docs/reports/motion_planning_report.html -diff -whitespace linguist-generated=true
third_party/** -whitespace linguist-vendored=true
# Licensed paper transcription and pinned upstream excerpts retain source formatting.
docs/research/gap/paper/** -whitespace linguist-generated=true
docs/research/gap/upstream/** -whitespace linguist-vendored=true
