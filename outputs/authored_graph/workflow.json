{
  "version": 3,
  "meta": {
    "name": "pick_into_basket",
    "description": "Pick the blue and yellow alphabet soup can and place it in the basket (direct-IK align-then-descend grasp; authored with gap.builder)."
  },
  "nodes": {
    "target": {
      "type": "subgraph",
      "ref": "target_sg"
    },
    "container": {
      "type": "subgraph",
      "ref": "container_sg"
    },
    "grasp": {
      "type": "subgraph",
      "ref": "grasp_sg"
    },
    "transport": {
      "type": "subgraph",
      "ref": "transport_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "robot.open_gripper",
          "inputs": {}
        },
        {
          "tool": "robot.go_home",
          "inputs": {}
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "target"
    ]
  ],
  "conditional_edges": {
    "target": {
      "router_field": "exit",
      "mapping": {
        "found": "container",
        "not_found": "abort"
      }
    },
    "container": {
      "router_field": "exit",
      "mapping": {
        "found": "grasp",
        "not_found": "abort"
      }
    },
    "grasp": {
      "router_field": "exit",
      "mapping": {
        "grasped": "transport",
        "failed": "abort"
      }
    },
    "transport": {
      "router_field": "exit",
      "mapping": {
        "placed": "done",
        "blocked": "abort"
      }
    }
  },
  "subgraphs": {
    "target_sg": {
      "skill": "perceiving-objects",
      "inputs": {},
      "outputs": {
        "target_obb": {
          "$ref": "filter_obb.obb"
        },
        "target_mask": {
          "$ref": "perceive.mask"
        },
        "target_cloud": {
          "$ref": "perceive.cloud"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "perceive": {
          "type": "script",
          "inputs": {
            "cameras": {
              "$ref": "observe.cameras"
            },
            "object_name": "blue and yellow alphabet soup can"
          },
          "script": "scripts/perceive_dino_vlm.py"
        },
        "filter_obb": {
          "type": "tool",
          "inputs": {
            "points": {
              "$ref": "perceive.cloud"
            }
          },
          "tool": "geometry.filter_and_compute_obb"
        },
        "found": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "perceive"
        ],
        [
          "perceive",
          "filter_obb"
        ],
        [
          "filter_obb",
          "found"
        ],
        [
          "found",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "found"
        ]
      },
      "on_error": "not_found"
    },
    "container_sg": {
      "skill": "perceiving-objects",
      "inputs": {},
      "outputs": {
        "container_obb": {
          "$ref": "filter_obb.obb"
        },
        "container_mask": {
          "$ref": "perceive.mask"
        },
        "container_cloud": {
          "$ref": "perceive.cloud"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "perceive": {
          "type": "script",
          "inputs": {
            "cameras": {
              "$ref": "observe.cameras"
            },
            "object_name": "basket"
          },
          "script": "scripts/perceive_dino_vlm.py"
        },
        "filter_obb": {
          "type": "tool",
          "inputs": {
            "points": {
              "$ref": "perceive.cloud"
            }
          },
          "tool": "geometry.filter_and_compute_obb"
        },
        "found": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "perceive"
        ],
        [
          "perceive",
          "filter_obb"
        ],
        [
          "filter_obb",
          "found"
        ],
        [
          "found",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "found"
        ]
      },
      "on_error": "not_found"
    },
    "grasp_sg": {
      "skill": "grasping-direct-ik",
      "inputs": {
        "target_obb": "OrientedBoundingBox"
      },
      "outputs": {},
      "nodes": {
        "open": {
          "type": "tool",
          "inputs": {
            "settle_steps": 40
          },
          "tool": "robot.open_gripper"
        },
        "compute_grasp": {
          "type": "tool",
          "inputs": {
            "obb": {
              "$ref": "in.target_obb"
            }
          },
          "tool": "geometry.top_down_grasp_candidates"
        },
        "compute_align": {
          "type": "script",
          "inputs": {
            "grasp_pose": {
              "$ref": "compute_grasp.candidates.poses.0"
            },
            "target_obb": {
              "$ref": "in.target_obb"
            }
          },
          "script": "scripts/compute_align_pose.py"
        },
        "rotate_align": {
          "type": "tool",
          "inputs": {
            "pose": {
              "$ref": "compute_align.align_pose"
            }
          },
          "tool": "robot.go_to_pose"
        },
        "descend": {
          "type": "tool",
          "inputs": {
            "pose": {
              "$ref": "compute_grasp.candidates.poses.0"
            }
          },
          "tool": "robot.go_to_pose"
        },
        "close": {
          "type": "tool",
          "inputs": {
            "settle_steps": 60
          },
          "tool": "robot.close_gripper"
        },
        "grasped": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "open"
        ],
        [
          "open",
          "compute_grasp"
        ],
        [
          "compute_grasp",
          "compute_align"
        ],
        [
          "compute_align",
          "rotate_align"
        ],
        [
          "rotate_align",
          "descend"
        ],
        [
          "descend",
          "close"
        ],
        [
          "close",
          "grasped"
        ],
        [
          "grasped",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "grasped"
        ]
      },
      "on_error": "failed"
    },
    "transport_sg": {
      "skill": "transporting-objects",
      "inputs": {
        "container_obb": "OrientedBoundingBox"
      },
      "outputs": {
        "drop_pose": {
          "$ref": "compute_drop.drop_pose"
        }
      },
      "nodes": {
        "compute_drop": {
          "type": "script",
          "inputs": {
            "container_obb": {
              "$ref": "in.container_obb"
            }
          },
          "script": "scripts/compute_drop_pose.py"
        },
        "move_above": {
          "type": "script",
          "inputs": {
            "drop_x": {
              "$ref": "compute_drop.drop_position.x"
            },
            "drop_y": {
              "$ref": "compute_drop.drop_position.y"
            },
            "drop_rotation": {
              "$ref": "compute_drop.drop_pose.rotation"
            }
          },
          "script": "scripts/waypoint_move.py"
        },
        "release": {
          "type": "script",
          "inputs": {
            "drop_position": {
              "$ref": "compute_drop.drop_position"
            },
            "drop_rotation": {
              "$ref": "compute_drop.drop_pose.rotation"
            }
          },
          "script": "scripts/descend_release.py"
        },
        "placed": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "compute_drop"
        ],
        [
          "compute_drop",
          "move_above"
        ],
        [
          "move_above",
          "release"
        ],
        [
          "release",
          "placed"
        ],
        [
          "placed",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "placed"
        ]
      },
      "on_error": "blocked"
    }
  }
}